+  if (request == REQUEST_NONE) return d;
+
+  if (request != MODE_ESTOP && request != MODE_MANUAL && request != MODE_AUTONOMOUS) {
+    d.accepted = false;
+    d.reason   = "unknown_mode";
+    return d;
+  }
