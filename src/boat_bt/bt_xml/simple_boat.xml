<root BTCPP_format="4" main_tree_to_execute="MainTree">

  <!--
    Njord 2026 autonomous mission Behavior Tree

    Implemented task-level behaviors:
      - Maneuvering / Path Finding
      - Cardinal marker handling
      - Collision Avoidance

    Docking is intentionally not included yet.

    Priority:
      1. Localization must be available.
      2. Collision risks are handled first.
      3. Cardinal-marker path-finding decisions are handled next.
      4. Mission lifecycle is monitored continuously.

    Navigation changes are requested through Mission Manager.
    The Behavior Tree does not send NavigateToPose goals directly.
  -->

  <BehaviorTree ID="MainTree">

    <ReactiveSequence name="NjordMission">

      <WaitForOdom/>

      <!--
        Highest-priority task behavior.

        When a dangerous obstacle is detected:
          CollisionRiskDetected
            -> DetermineAvoidanceTarget
            -> RequestAvoidance

        If no collision risk exists, normal mission execution continues.
      -->
      <Fallback name="OptionalCollisionAvoidance">

        <Sequence name="CollisionAvoidance">

          <CollisionRiskDetected/>

          <DetermineAvoidanceTarget/>

          <RequestAvoidance/>

        </Sequence>

        <AlwaysSuccess/>

      </Fallback>

      <!--
        Maneuvering / Path Finding.

        When a configured cardinal marker is detected:
          CardinalMarkerDetected
            -> DeterminePassingSide
            -> DetermineCardinalBypassTarget
            -> RequestCardinalBypass

        If no relevant marker exists, normal GPS/Nav2 navigation continues.
      -->
      <Fallback name="OptionalCardinalMarkerHandling">

        <Sequence name="CardinalMarkerHandling">

          <CardinalMarkerDetected/>

          <DeterminePassingSide/>

          <DetermineCardinalBypassTarget/>

          <RequestCardinalBypass/>

        </Sequence>

        <AlwaysSuccess/>

      </Fallback>

      <!--
        Mission lifecycle:
          IDLE / RUNNING -> RUNNING
          SUCCEEDED      -> SUCCESS
          FAILED         -> FAILURE
          ABORTED        -> FAILURE
      -->
      <MissionMonitor/>

    </ReactiveSequence>

  </BehaviorTree>

</root>