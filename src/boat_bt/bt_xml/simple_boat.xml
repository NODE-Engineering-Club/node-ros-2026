<root BTCPP_format="4" main_tree_to_execute="MainTree">

  <BehaviorTree ID="MainTree">
    <ReactiveSequence name="NjordMission">
      <WaitForOdom/>
      <SubTree ID="GlobalSafety"/>
      <SubTree ID="CompetitionTaskSelector"/>
      <MissionMonitor/>
    </ReactiveSequence>
  </BehaviorTree>

  <BehaviorTree ID="GlobalSafety">
    <Fallback name="OptionalGlobalCollisionAvoidance">

      <!--
        During docking, the dock geometry is intentionally approached at
        close range. It must not be interpreted as a generic obstacle that
        triggers a global bypass request before ExecuteDocking can run.
        Same reasoning applies to parallel docking (Task 3.2) against its
        own berth geometry.
      -->
      <IsTask task="docking"/>
      <IsTask task="docking_parallel"/>

      <Sequence name="GlobalCollisionAvoidance">
        <CollisionRiskDetected/>
        <DetermineAvoidanceTarget/>
        <RequestAvoidance/>
      </Sequence>

      <AlwaysSuccess/>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="CompetitionTaskSelector">
    <Fallback name="TaskSelector">

      <Sequence name="SelectManeuveringTask">
        <IsTask task="maneuvering"/>
        <SubTree ID="ManeuveringTask"/>
      </Sequence>

      <Sequence name="SelectPathFindingTask">
        <IsTask task="path_finding"/>
        <SubTree ID="PathFindingTask"/>
      </Sequence>

      <Sequence name="SelectCollisionAvoidanceTask">
        <IsTask task="collision_avoidance"/>
        <SubTree ID="CollisionAvoidanceTask"/>
      </Sequence>

      <Sequence name="SelectDockingTask">
        <IsTask task="docking"/>
        <SubTree ID="DockingTask"/>
      </Sequence>

      <Sequence name="SelectDockingParallelTask">
        <IsTask task="docking_parallel"/>
        <SubTree ID="DockingParallelTask"/>
      </Sequence>

      <Sequence name="SelectSurpriseTask">
        <IsTask task="surprise"/>
        <SubTree ID="SurpriseTask"/>
      </Sequence>

      <AlwaysSuccess/>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="ManeuveringTask">
    <Fallback name="OptionalManeuveringCardinalHandling">
      <Sequence name="ManeuveringCardinalMarkerHandling">
        <CardinalMarkerDetected/>
        <DeterminePassingSide/>
        <DetermineCardinalBypassTarget/>
        <RequestCardinalBypass/>
      </Sequence>
      <AlwaysSuccess/>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="PathFindingTask">
    <Fallback name="OptionalPathFindingCardinalHandling">
      <Sequence name="PathFindingCardinalMarkerHandling">
        <CardinalMarkerDetected/>
        <DeterminePassingSide/>
        <DetermineCardinalBypassTarget/>
        <RequestCardinalBypass/>
      </Sequence>
      <AlwaysSuccess/>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="CollisionAvoidanceTask">
    <Fallback name="CollisionAvoidanceMission">

      <Sequence name="ExecuteCollisionAvoidance">
        <CollisionRiskDetected/>
        <DetermineAvoidanceTarget/>
        <RequestAvoidance/>
      </Sequence>

      <!--
        No current collision risk is not task completion.
        MissionMonitor remains responsible for deciding whether the
        competition mission is still running, succeeded, failed or aborted.
      -->
      <AlwaysSuccess/>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="DockingTask">
    <ExecuteDocking/>
  </BehaviorTree>

  <!--
    Task 3.2 (Parallel Docking). ExecuteDockingParallel is a real
    controller now (parallel_docking_nodes.cpp), not the AlwaysSuccess
    placeholder this used to be — but UNVERIFIED: it has never been run
    against a real wall, on the bench or in the water. It reuses
    ExecuteDocking's bearing+heading blended steering law, retargeted at a
    wall-parallel standoff point (WallTarget.aim_point/heading, from the
    also-unverified wall_detector_node) instead of a U-opening. Do not
    enable enable_docking_parallel_mission for a real attempt without a
    bench check first — see njord.launch.py's DeclareLaunchArgument.
  -->
  <BehaviorTree ID="DockingParallelTask">
    <ExecuteDockingParallel/>
  </BehaviorTree>

  <BehaviorTree ID="SurpriseTask">
    <AlwaysSuccess/>
  </BehaviorTree>

</root>
