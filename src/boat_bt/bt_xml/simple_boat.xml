<root BTCPP_format="4" main_tree_to_execute="MainTree">

  <BehaviorTree ID="MainTree">
    <ReactiveSequence name="NjordMission">
      <WaitForOdom/>
      <SubTree ID="GlobalSafety"/>
      <SubTree ID="CompetitionTaskSelector"/>
      <MissionMonitor/>
    </ReactiveSequence>
  </BehaviorTree>

  <BehaviorTree ID="GlobalSafety">
    <Fallback name="OptionalGlobalCollisionAvoidance">

      <!--
        During docking, the dock geometry is intentionally approached at
        close range. It must not be interpreted as a generic obstacle that
        triggers a global bypass request before ExecuteDocking can run.
        Same reasoning applies to parallel docking (Task 3.2) against its
        own berth geometry.
      -->
      <IsTask task="docking"/>
      <IsTask task="docking_parallel"/>

      <Sequence name="GlobalCollisionAvoidance">
        <CollisionRiskDetected/>
        <DetermineAvoidanceTarget/>
        <RequestAvoidance/>
      </Sequence>

      <AlwaysSuccess/>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="CompetitionTaskSelector">
    <Fallback name="TaskSelector">

      <Sequence name="SelectManeuveringTask">
        <IsTask task="maneuvering"/>
        <SubTree ID="ManeuveringTask"/>
      </Sequence>

      <Sequence name="SelectPathFindingTask">
        <IsTask task="path_finding"/>
        <SubTree ID="PathFindingTask"/>
      </Sequence>

      <Sequence name="SelectCollisionAvoidanceTask">
        <IsTask task="collision_avoidance"/>
        <SubTree ID="CollisionAvoidanceTask"/>
      </Sequence>

      <Sequence name="SelectDockingTask">
        <IsTask task="docking"/>
        <SubTree ID="DockingTask"/>
      </Sequence>

      <Sequence name="SelectDockingParallelTask">
        <IsTask task="docking_parallel"/>
        <SubTree ID="DockingParallelTask"/>
      </Sequence>

      <Sequence name="SelectSurpriseTask">
        <IsTask task="surprise"/>
        <SubTree ID="SurpriseTask"/>
      </Sequence>

      <AlwaysSuccess/>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="ManeuveringTask">
    <Fallback name="OptionalManeuveringCardinalHandling">
      <Sequence name="ManeuveringCardinalMarkerHandling">
        <CardinalMarkerDetected/>
        <DeterminePassingSide/>
        <DetermineCardinalBypassTarget/>
        <RequestCardinalBypass/>
      </Sequence>
      <AlwaysSuccess/>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="PathFindingTask">
    <Fallback name="OptionalPathFindingCardinalHandling">
      <Sequence name="PathFindingCardinalMarkerHandling">
        <CardinalMarkerDetected/>
        <DeterminePassingSide/>
        <DetermineCardinalBypassTarget/>
        <RequestCardinalBypass/>
      </Sequence>
      <AlwaysSuccess/>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="CollisionAvoidanceTask">
    <!--
      Task 9.2. GlobalSafety (MainTree) already runs its generic
      bearing-only obstacle bypass unconditionally for this task: unlike
      docking/docking_parallel, collision_avoidance has no close-range-
      approach conflict with that reflex, so it is NOT excluded there (no
      new IsTask entry added to GlobalSafety's Fallback). This subtree
      layers the task-specific, velocity-aware COLREG give-way maneuver
      against the marker vessel on top of it, exactly as
      ManeuveringTask/PathFindingTask layer cardinal-marker handling on top
      of GlobalSafety. Gate-crossing tracking (gate1_crossed_/
      gate2_crossed_) and marker-vessel identification happen per-tick in
      collision_nodes.cpp's updateGateState/updateMarkerVesselState, driven
      by /obstacles/global, not by BT nodes below.

      Task completion is NOT signalled from here: collision_avoidance.yaml
      now carries real (see its own TODO) point-5/point-6 waypoints, so
      competition_manager routes /competition/start through
      mission_manager's normal waypoint transit, and success is
      mission_manager's own final-hold-at-point-6 mechanism, identical to
      maneuvering/path_finding, NOT the /competition/complete pattern
      docking/docking_parallel use.
    -->
    <Fallback name="OptionalMarkerVesselGiveWay">
      <Sequence name="MarkerVesselGiveWayHandling">
        <MarkerVesselDetected/>
        <DetermineGiveWaySide/>
        <DetermineGiveWayTarget/>
        <RequestGiveWayBypass/>
      </Sequence>
      <AlwaysSuccess/>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="DockingTask">
    <ExecuteDocking/>
  </BehaviorTree>

  <!--
    Task 3.2 (Parallel Docking). ExecuteDockingParallel is a real
    controller now (parallel_docking_nodes.cpp), not the AlwaysSuccess
    placeholder this used to be — but UNVERIFIED: it has never been run
    against a real wall, on the bench or in the water. It reuses
    ExecuteDocking's bearing+heading blended steering law, retargeted at a
    wall-parallel standoff point (WallTarget.aim_point/heading, from the
    also-unverified wall_detector_node) instead of a U-opening. Do not
    enable enable_docking_parallel_mission for a real attempt without a
    bench check first — see njord.launch.py's DeclareLaunchArgument.
  -->
  <BehaviorTree ID="DockingParallelTask">
    <ExecuteDockingParallel/>
  </BehaviorTree>

  <!--
    Task 9.4 (Surprise). Team working draft, not an official spec, see
    TODOS.md. Selected by surprise_mission's sequencer only during the
    open-water leg between the two dockings (task is TASK_DOCKING /
    TASK_DOCKING_PARALLEL, not TASK_SURPRISE, during the dockings
    themselves, so GlobalSafety's docking suppression above still applies
    to those phases unchanged). Layers cardinal-mark passing (reused as-is
    from ManeuveringTask/PathFindingTask) and individual buoy COLREG-side
    passing (new, Task-9.4-specific, see collision_nodes.cpp's
    updateBuoyMarkerState / bt_registration.cpp's Buoy* nodes) on top of
    GlobalSafety's generic buoy-standoff + collision-risk reflex, which
    fires unconditionally for this task same as it does for
    collision_avoidance. Cardinal handling is tried first: both branches
    share the same single bypass-target mechanism
    (/mission/set_bypass_target), so only one detour can be active at a
    time, a real limitation if a cardinal mark and a buoy both need
    action in the same tick, not expected to matter given the course
    sketch's spacing but worth knowing about.
  -->
  <BehaviorTree ID="SurpriseTask">
    <Fallback name="OptionalSurpriseTransitHandling">
      <Sequence name="SurpriseCardinalMarkerHandling">
        <CardinalMarkerDetected/>
        <DeterminePassingSide/>
        <DetermineCardinalBypassTarget/>
        <RequestCardinalBypass/>
      </Sequence>
      <Sequence name="SurpriseBuoyColregHandling">
        <BuoyMarkerDetected/>
        <DetermineBuoyPassingSide/>
        <DetermineBuoyBypassTarget/>
        <RequestBuoyBypass/>
      </Sequence>
      <AlwaysSuccess/>
    </Fallback>
  </BehaviorTree>

</root>
