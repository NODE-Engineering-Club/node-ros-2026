<root BTCPP_format="4" main_tree_to_execute="MainTree">

  <BehaviorTree ID="MainTree">
    <ReactiveSequence name="NjordMission">
      <WaitForOdom/>
      <SubTree ID="GlobalSafety"/>
      <SubTree ID="CompetitionTaskSelector"/>
      <MissionMonitor/>
    </ReactiveSequence>
  </BehaviorTree>

  <BehaviorTree ID="GlobalSafety">
    <Fallback name="OptionalGlobalCollisionAvoidance">

      <!--
        During docking, the dock geometry is intentionally approached at
        close range. It must not be interpreted as a generic obstacle that
        triggers a global bypass request before ExecuteDocking can run.
      -->
      <IsTask task="docking"/>

      <Sequence name="GlobalCollisionAvoidance">
        <CollisionRiskDetected/>
        <DetermineAvoidanceTarget/>
        <RequestAvoidance/>
      </Sequence>

      <AlwaysSuccess/>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="CompetitionTaskSelector">
    <Fallback name="TaskSelector">

      <Sequence name="SelectManeuveringTask">
        <IsTask task="maneuvering"/>
        <SubTree ID="ManeuveringTask"/>
      </Sequence>

      <Sequence name="SelectPathFindingTask">
        <IsTask task="path_finding"/>
        <SubTree ID="PathFindingTask"/>
      </Sequence>

      <Sequence name="SelectCollisionAvoidanceTask">
        <IsTask task="collision_avoidance"/>
        <SubTree ID="CollisionAvoidanceTask"/>
      </Sequence>

      <Sequence name="SelectDockingTask">
        <IsTask task="docking"/>
        <SubTree ID="DockingTask"/>
      </Sequence>

      <Sequence name="SelectSurpriseTask">
        <IsTask task="surprise"/>
        <SubTree ID="SurpriseTask"/>
      </Sequence>

      <AlwaysSuccess/>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="ManeuveringTask">
    <Fallback name="OptionalManeuveringCardinalHandling">
      <Sequence name="ManeuveringCardinalMarkerHandling">
        <CardinalMarkerDetected/>
        <DeterminePassingSide/>
        <DetermineCardinalBypassTarget/>
        <RequestCardinalBypass/>
      </Sequence>
      <AlwaysSuccess/>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="PathFindingTask">
    <Fallback name="OptionalPathFindingCardinalHandling">
      <Sequence name="PathFindingCardinalMarkerHandling">
        <CardinalMarkerDetected/>
        <DeterminePassingSide/>
        <DetermineCardinalBypassTarget/>
        <RequestCardinalBypass/>
      </Sequence>
      <AlwaysSuccess/>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="CollisionAvoidanceTask">
    <AlwaysSuccess/>
  </BehaviorTree>

  <BehaviorTree ID="DockingTask">
    <ExecuteDocking/>
  </BehaviorTree>

  <BehaviorTree ID="SurpriseTask">
    <AlwaysSuccess/>
  </BehaviorTree>

</root>